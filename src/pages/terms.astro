  <div class="toc">
    <h2>Contents</h2>
    <ol>
      <li><a href="#parties">Parties and definitions</a></li>
      <li><a href="#service">The service</a></li>
      <li><a href="#accounts">Accounts and access</a></li>
      <li><a href="#sub">Subscriptions and modules</a></li>
      <li><a href="#fees">Fees and payment</a></li>
      <li><a href="#trial">Free trial</a></li>
      <li><a href="#use">Acceptable use</a></li>
      <li><a href="#yourdata">Your data</a></li>
      <li><a href="#dp">Data protection</a></li>
