---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Page not found | GarageCloud"
  description="That page doesn't exist or has moved. Head back to the GarageCloud homepage."
  noindex
>
  <SiteHeader />
  <main class="mx-auto flex max-w-2xl flex-col items-center px-6 py-24 text-center sm:py-32">
    <span class="text-gradient-primary font-heading text-6xl font-extrabold tracking-tight sm:text-7xl">404</span>
    <h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">Page not found</h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-body-text">
      That page doesn't exist, or it's moved. Check the address, or head back to the homepage.
    </p>

    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="/"
        class="bg-gradient-primary w-full rounded-full px-7 py-3.5 font-heading text-base font-bold text-white shadow-lg shadow-coral-orange/20 transition-transform hover:scale-[1.03] sm:w-auto"
      >
        Back to homepage
      </a>
      <a
        href="/garage-management-software"
        class="w-full rounded-full border border-border-grey px-7 py-3.5 font-heading text-base font-bold text-workshop-black transition-colors hover:border-workshop-black sm:w-auto"
      >
        See what GarageCloud does
      </a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
