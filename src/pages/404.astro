---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Page not found | GarageCloud"
  description="That page doesn't exist or has moved. Head back to the GarageCloud homepage."
  noindex
>
  <SiteHeader />
  <main class="mx-auto flex max-w-2xl flex-col items-center px-6 py-24 text-center sm:py-32">
    <span class="tabular font-num text-7xl font-bold text-navy sm:text-8xl">404</span>
    <h1 class="mt-4 font-heading text-h1 font-bold">Page not found</h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-body-text">
      That page doesn't exist, or it's moved. Check the address, or head back to the homepage.
    </p>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/"
        class="btn btn-primary w-full sm:w-auto"
      >
        Back to homepage
      </a>
      <a
        href="/garage-management-software"
        class="btn btn-secondary w-full sm:w-auto"
      >
        See what GarageCloud does
      </a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
