---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lede: string;
  breadcrumbLabel: string;
}

const { title, description, eyebrow, heading, lede, breadcrumbLabel } = Astro.props;

const pageURL = new URL(Astro.url.pathname, Astro.site).toString();

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: Astro.site?.toString() },
    { "@type": "ListItem", position: 2, name: breadcrumbLabel, item: pageURL },
  ],
};
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main>
    <div class="border-b border-border-grey bg-section-grey">
      <div class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex items-center gap-2 text-sm text-muted-text">
            <li><a href="/" class="transition-colors hover:text-workshop-black">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-workshop-black" aria-current="page">{breadcrumbLabel}</li>
          </ol>
        </nav>
        <p class="brand-label text-body-text">{eyebrow}</p>
        <h1 class="mt-3 font-heading text-h1 font-bold text-balance lg:text-display">{heading}</h1>
        <p class="mt-6 text-lg leading-relaxed text-body-text">{lede}</p>
      </div>
    </div>

    <article class="article-prose mx-auto max-w-3xl px-6 py-14 text-body-text">
      <slot />
    </article>

    <slot name="full-width" />

    <div class="mx-auto max-w-page px-6 pt-8 lg:px-20">
      <div class="rounded-lg bg-navy px-6 py-14 text-center sm:px-12">
        <h2 class="font-heading text-h2 font-bold text-white sm:text-h1">Join the waiting list</h2>
        <p class="mx-auto mt-3 max-w-md text-white/85">
          Get early access when GarageCloud opens, and help shape what ships first.
        </p>
        <a href="/#waiting-list" class="btn btn-on-dark mt-6">Join the waiting list</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
