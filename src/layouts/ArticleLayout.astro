---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lede: string;
  breadcrumbLabel: string;
}

const { title, description, eyebrow, heading, lede, breadcrumbLabel } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main>
    <div class="border-b border-border-grey bg-section-grey">
      <div class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
        <nav aria-label="Breadcrumb" class="mb-4">
          <ol class="flex items-center gap-2 text-xs font-semibold text-muted-text">
            <li><a href="/" class="hover:text-coral-orange">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-workshop-black" aria-current="page">{breadcrumbLabel}</li>
          </ol>
        </nav>
        <span class="text-coral-orange font-heading text-xs font-bold uppercase tracking-widest">{eyebrow}</span>
        <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{heading}</h1>
        <p class="mt-4 text-lg leading-relaxed text-body-text">{lede}</p>
      </div>
    </div>

    <article class="article-prose mx-auto max-w-3xl px-6 py-14 text-body-text">
      <slot />
    </article>

    <slot name="full-width" />

    <div class="bg-gradient-dark relative overflow-hidden">
      <div
        class="bg-gradient-primary pointer-events-none absolute -bottom-24 left-1/2 h-64 w-[32rem] -translate-x-1/2 rounded-full opacity-20 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto max-w-3xl px-6 py-14 text-center">
        <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">Join the waiting list</h2>
        <p class="mx-auto mt-3 max-w-md text-sm text-white/70">
          Get early access when GarageCloud opens, and help shape what ships first.
        </p>
        <a
          href="/#waiting-list"
          class="bg-gradient-primary mt-6 inline-block rounded-full px-7 py-3.5 font-heading text-sm font-bold text-white shadow-lg shadow-coral-orange/20 transition-transform hover:scale-[1.03]"
        >
          Join the waiting list
        </a>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
