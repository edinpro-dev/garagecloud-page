---
import { STATS } from "../data/site";
---

<section class="bg-section-grey border-y border-border-grey" aria-label="Product facts">
  <div class="mx-auto grid max-w-4xl grid-cols-1 divide-y divide-border-grey px-6 py-10 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
    {
      STATS.map((stat) => (
        <div class="flex flex-col items-center gap-1 py-6 text-center sm:py-0">
          <span class="text-gradient-primary font-heading text-4xl font-extrabold">{stat.value}</span>
          <span class="text-sm text-muted-text">{stat.label}</span>
        </div>
      ))
    }
  </div>
</section>
