---
import { INTEGRATIONS, WHY_JOIN_NOW } from "../data/site";
import IntegrationMark from "./IntegrationMark.astro";
---

<section class="border-b border-border-grey bg-section-grey">
  <div class="mx-auto max-w-page px-6 py-20 lg:px-20">
    <div class="max-w-[60ch]">
      <p class="brand-label text-body-text">Why now</p>
      <h2 class="mt-3 font-heading text-h1 font-bold text-balance">Why join now</h2>
      <p class="mt-4 text-body-text">
        GarageCloud isn't live yet. We're setting workshops up from the waiting list first, which means the people on
        it get a say in what ships.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <ul class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
        {
          WHY_JOIN_NOW.map((reason) => (
            <li class="flex flex-col gap-4 rounded-lg border border-border-strong bg-canvas-white p-6 lg:flex-row lg:items-start">
              <span class="icon-chip">
                <reason.icon class="size-5" stroke-width={1.75} />
              </span>
              <div>
                <h3 class="font-heading text-base font-semibold">{reason.title}</h3>
                <p class="mt-2 text-sm text-body-text">{reason.description}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="rounded-lg bg-dark-surface p-6 text-white">
        <h3 class="font-heading text-h2 font-semibold text-balance text-white">
          Works with the tools you already use, from launch
        </h3>
        <p class="mt-3 text-sm text-white/75">
          Nothing to re-key at the end of the month. Invoices leave the job card and land in your accounts.
        </p>

        <ul class="mt-6 flex flex-col divide-y divide-dark-rule border-t border-dark-rule">
          {
            INTEGRATIONS.map((integration) => (
              <li class="flex items-center justify-between gap-3 py-3">
                <span class="flex h-7 w-16 shrink-0 items-center">
                  <IntegrationMark name={integration.name} size="sm" />
                </span>
                <span class="text-right text-xs text-white/70">{integration.description}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
