---
import { WHY_JOIN_NOW } from "../data/site";
---

<section class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Why join now</h2>
  </div>

  <div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-3">
    {
      WHY_JOIN_NOW.map((reason, index) => (
        <div class="text-center sm:text-left">
          <span class="text-gradient-primary font-heading text-3xl font-extrabold">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-3 text-lg font-bold text-workshop-black">{reason.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-text">{reason.description}</p>
        </div>
      ))
    }
  </div>
</section>
