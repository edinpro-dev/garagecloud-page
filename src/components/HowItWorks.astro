---
import { HOW_IT_WORKS } from "../data/site";
---

<section id="how-it-works" class="bg-section-grey py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-coral-orange font-heading text-xs font-bold uppercase tracking-widest">How it works</span>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">From waiting list to live in three steps</h2>
    </div>

    <div class="relative mt-14 grid grid-cols-1 gap-8 sm:grid-cols-3">
      <div class="pointer-events-none absolute top-6 right-0 left-0 hidden h-px bg-border-grey sm:block" aria-hidden="true"></div>

      {
        HOW_IT_WORKS.map((step, index) => (
          <div class="relative flex flex-col items-center text-center sm:items-start sm:text-left">
            <div class="bg-gradient-primary relative z-10 flex h-12 w-12 items-center justify-center rounded-full font-heading text-lg font-extrabold text-white">
              {index + 1}
            </div>
            <h3 class="mt-4 text-lg font-bold text-workshop-black">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-text">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
