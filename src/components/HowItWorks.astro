---
import { ArrowRight } from "@lucide/astro";
import { HOW_IT_WORKS } from "../data/site";
---

<section id="how-it-works" class="border-b border-border-grey">
  <div class="mx-auto max-w-page px-6 py-20 lg:px-20">
    <div class="mx-auto max-w-[60ch] text-center">
      <p class="brand-label text-body-text">How it works</p>
      <h2 class="mt-3 font-heading text-h1 font-bold text-balance">From waiting list to live in three steps</h2>
      <p class="mt-4 text-body-text">
        No IT project and no six week implementation. We set the workspace up with you, then you start putting jobs
        through it.
      </p>
    </div>

    <div class="relative mt-12 grid gap-12 md:grid-cols-3 md:gap-8">
      <div aria-hidden="true" class="absolute top-7 right-[16%] left-[16%] hidden h-px bg-border-grey md:block"></div>

      {
        HOW_IT_WORKS.map((step, index) => (
          <div class="relative flex flex-col items-center text-center">
            <div class="relative flex size-14 items-center justify-center rounded-lg bg-dark-surface text-white">
              <step.icon class="size-6" stroke-width={1.75} />
              <span class="tabular absolute -top-2 -right-2 flex size-6 items-center justify-center rounded-full border-2 border-canvas-white bg-ground font-heading text-xs font-bold text-workshop-black">
                {index + 1}
              </span>
            </div>
            <h3 class="mt-6 font-heading text-h2 font-semibold">{step.title}</h3>
            <p class="mt-2 max-w-[40ch] text-sm text-body-text">{step.description}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex justify-center">
      <a href="/#waiting-list" class="btn btn-primary">
        Join the waiting list
        <ArrowRight class="size-4" />
      </a>
    </div>
  </div>
</section>
