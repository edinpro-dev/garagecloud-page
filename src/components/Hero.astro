---
import { HERO } from "../data/site";

const jobs = [
  { plate: "LV21 KRA", job: "Full service", eta: "Bay 2", accent: "bg-coral-orange" },
  { plate: "MK70 GXP", job: "Brake inspection", eta: "Bay 4", accent: "bg-deep-magenta" },
  { plate: "BD19 TSN", job: "MOT retest", eta: "Bay 1", accent: "bg-deep-purple" },
  { plate: "RV22 FLW", job: "Tyre change", eta: "Mobile", accent: "bg-amber-orange" },
];
---

<section class="relative overflow-hidden">
  <div
    class="bg-road-texture pointer-events-none absolute inset-0 opacity-[0.04]"
    aria-hidden="true"
  >
  </div>
  <div
    class="bg-gradient-primary pointer-events-none absolute -top-32 left-1/2 h-[28rem] w-[64rem] -translate-x-1/2 rounded-full opacity-20 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-coral-orange/40 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 px-6 py-20 sm:py-28 lg:grid-cols-2 lg:gap-12">
    <div class="text-center lg:text-left">
      <span
        class="bg-gradient-primary inline-block rounded-full px-4 py-1.5 font-heading text-xs font-bold uppercase tracking-wide text-white"
      >
        {HERO.badge}
      </span>

      <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight sm:text-6xl">
        {HERO.heading}
      </h1>

      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-body-text sm:text-xl lg:mx-0">
        {HERO.subheading}
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
        <a
          href="#waiting-list"
          class="bg-gradient-primary w-full rounded-full px-7 py-3.5 font-heading text-base font-bold text-white shadow-lg shadow-coral-orange/20 transition-transform hover:scale-[1.03] sm:w-auto"
        >
          {HERO.primaryCta}
        </a>
        <a
          href="#features"
          class="w-full rounded-full border border-border-grey px-7 py-3.5 font-heading text-base font-bold text-workshop-black transition-colors hover:border-workshop-black sm:w-auto"
        >
          {HERO.secondaryCta}
        </a>
      </div>

      <p class="mt-8 text-sm text-muted-text">{HERO.trustLine}</p>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:max-w-none" aria-hidden="true">
      <div
        class="bg-gradient-primary absolute -inset-4 -z-10 rounded-[2rem] opacity-20 blur-2xl"
      >
      </div>

      <div class="rounded-2xl border border-border-grey bg-canvas-white shadow-2xl shadow-workshop-black/10">
        <div class="flex items-center gap-2 rounded-t-2xl border-b border-border-grey bg-section-grey px-4 py-3">
          <span class="h-2.5 w-2.5 rounded-full bg-coral-orange/60"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-amber-orange/60"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-deep-purple/60"></span>
          <span class="ml-2 font-heading text-xs font-bold text-muted-text">Live workshop board</span>
        </div>

        <div class="grid grid-cols-2 gap-3 p-4">
          {
            jobs.map((job) => (
              <div class="rounded-xl border border-border-grey bg-section-grey/60 p-3">
                <div class="flex items-center gap-1.5">
                  <span class={`h-2 w-2 rounded-full ${job.accent}`} />
                  <span class="font-heading text-[11px] font-bold tracking-wide text-workshop-black">{job.plate}</span>
                </div>
                <p class="mt-2 text-xs text-body-text">{job.job}</p>
                <p class="mt-1 text-[11px] font-semibold text-muted-text">{job.eta}</p>
              </div>
            ))
          }
        </div>

        <div class="flex items-center justify-between border-t border-border-grey px-4 py-3">
          <span class="text-[11px] font-semibold text-muted-text">4 jobs in progress</span>
          <span class="text-gradient-primary font-heading text-[11px] font-bold">On schedule</span>
        </div>
      </div>
    </div>
  </div>
</section>
