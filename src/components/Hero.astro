---
import { ArrowRight, CircleCheck } from "@lucide/astro";
import AppWindowMock from "./AppWindowMock.astro";
import IntegrationLogos from "./IntegrationLogos.astro";
import { HERO, STATS } from "../data/site";

const [headingLead, headingTail] = HERO.heading.split(HERO.headingEmphasis);
---

<section class="relative isolate flex min-h-[calc(100svh-4rem)] flex-col overflow-hidden border-b border-border-grey">
  <!-- A neutral grid, no colour wash. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
    style="background-image: linear-gradient(to right, var(--color-border-grey) 1px, transparent 1px), linear-gradient(to bottom, var(--color-border-grey) 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(120% 90% at 60% 0%, black 25%, transparent 72%); -webkit-mask-image: radial-gradient(120% 90% at 60% 0%, black 25%, transparent 72%);"
  >
  </div>

  <div class="mx-auto grid w-full max-w-page flex-1 content-center items-center gap-12 px-6 pt-16 pb-16 lg:grid-cols-[1.05fr_1fr] lg:px-20">
    <div>
      <span class="badge">{HERO.badge}</span>

      <h1 class="mt-6 font-heading text-h1 font-bold text-balance lg:text-display">
        {headingLead}<span class="text-navy">{HERO.headingEmphasis}</span>{headingTail}
      </h1>

      <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-body-text">{HERO.subheading}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#waiting-list" class="btn btn-primary">
          {HERO.primaryCta}
          <ArrowRight class="size-4" />
        </a>
        <a href="#features" class="btn btn-secondary">{HERO.secondaryCta}</a>
      </div>


      <p class="mt-6 text-sm text-muted-text">{HERO.trustLine}</p>
    </div>

    <div class="relative lg:pl-4" aria-hidden="true">
      <AppWindowMock />

      <div class="absolute -bottom-10 -left-8 hidden w-60 rounded-lg border border-border-strong bg-canvas-white p-4 sm:block">
        <div class="flex items-center gap-3">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-status-complete text-status-complete-foreground">
            <CircleCheck class="size-4" />
          </span>
          <div class="min-w-0">
            <p class="text-xs font-semibold text-workshop-black">Inspection approved</p>
            <p class="text-xs text-muted-text">Customer replied on WhatsApp</p>
          </div>
        </div>
      </div>

      <div class="absolute -top-4 -right-2 hidden items-center gap-2 rounded-md border border-border-strong bg-canvas-white px-3 py-2 text-xs font-medium text-workshop-black md:flex">
        <span class="size-1.5 shrink-0 rounded-full bg-success"></span>
        Invoice <span class="tabular font-num font-semibold">INV1042</span> synced to Xero
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-page px-6 pb-12 lg:px-20">
    <IntegrationLogos />
  </div>

  <div class="border-t border-border-grey bg-section-grey" aria-label="Product facts">
    <div class="mx-auto grid max-w-page grid-cols-1 divide-y divide-border-grey px-6 sm:grid-cols-3 sm:divide-x sm:divide-y-0 lg:px-20">
      {
        STATS.map((stat) => (
          <div class="flex items-baseline gap-2 py-6 sm:justify-center">
            <span class="tabular font-num text-[28px] leading-none font-bold text-workshop-black">{stat.value}</span>
            <span class="text-sm text-body-text">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
