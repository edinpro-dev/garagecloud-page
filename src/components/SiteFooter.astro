---
import Logo from "./Logo.astro";
import { SITE } from "../data/site";

const year = new Date().getFullYear();

const columns = [
  {
    heading: "Product",
    links: [
      { href: "/#features", label: "Features" },
      { href: "/pricing", label: "Pricing" },
      { href: "/#how-it-works", label: "How it works" },
      { href: "/#faq", label: "FAQ" },
      { href: "/garage-management-software", label: "Garage management software" },
    ],
  },
  {
    heading: "Trades",
    links: [
      { href: "/mobile-tyre-fitting-software", label: "Mobile tyre fitting" },
      { href: "/auto-locksmith-software", label: "Auto locksmiths" },
      { href: "/ecu-remapping-software", label: "ECU remapping" },
      { href: "/mot-test-centre-software", label: "MOT test centres" },
      { href: "/fleet-maintenance-software", label: "Fleet maintenance" },
    ],
  },
  {
    heading: "Compare",
    links: [
      { href: "/vs/garage-hive", label: "vs Garage Hive" },
      { href: "/vs/techman", label: "vs TechMan" },
      { href: "/vs/dragon2000", label: "vs Dragon2000" },
      { href: "/vs/motasoft", label: "vs Motasoft" },
      { href: "/garage-hive-alternatives", label: "Garage Hive alternatives" },
    ],
  },
  {
    heading: "Company",
    links: [
      { href: "/contact", label: "Contact" },
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
      { href: "/#waiting-list", label: "Waiting list" },
    ],
  },
];
---

<footer>
  <div class="mx-auto max-w-page px-6 py-20 lg:px-20">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.5fr_repeat(4,1fr)]">
      <div>
        <a href="/" aria-label="GarageCloud home">
          <Logo iconSize={28} />
        </a>
        <p class="mt-4 max-w-[32ch] text-sm text-body-text">{SITE.strapline}</p>
        <a href={`mailto:${SITE.contactEmail}`} class="brand-link mt-4 inline-block text-sm font-medium">
          {SITE.contactEmail}
        </a>
      </div>

      {
        columns.map((column) => (
          <div>
            <h2 class="brand-label font-sans text-body-text">{column.heading}</h2>
            <ul class="mt-4 flex flex-col gap-3">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-body-text transition-colors hover:text-workshop-black">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-12 border-t border-border-grey pt-8 text-sm text-muted-text">
      © {year} {SITE.name}. All rights reserved.
    </p>
  </div>
</footer>
