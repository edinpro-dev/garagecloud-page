---
import Logo from "./Logo.astro";
import { SITE } from "../data/site";

const year = new Date().getFullYear();
const links = [
  { href: "/#features", label: "Features" },
  { href: "/#pricing", label: "Pricing" },
  { href: "/#faq", label: "FAQ" },
  { href: "/#waiting-list", label: "Waiting list" },
  { href: "/privacy", label: "Privacy" },
];
---

<footer class="border-t border-border-grey">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 py-10 sm:flex-row sm:justify-between">
    <Logo iconSize={26} />

    <nav class="flex items-center gap-6" aria-label="Footer">
      {
        links.map((link) => (
          <a href={link.href} class="text-sm font-semibold text-body-text transition-colors hover:text-coral-orange">
            {link.label}
          </a>
        ))
      }
    </nav>

    <p class="text-sm text-muted-text">
      © {year} {SITE.name}. <a href={`mailto:${SITE.contactEmail}`} class="hover:text-workshop-black">{SITE.contactEmail}</a>
    </p>
  </div>
</footer>
