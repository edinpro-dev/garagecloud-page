---
import Logo from "./Logo.astro";
import { SITE } from "../data/site";

const year = new Date().getFullYear();

const columns = [
  {
    heading: "Product",
    links: [
      { href: "/#features", label: "Features" },
      { href: "/pricing", label: "Pricing" },
      { href: "/#how-it-works", label: "How it works" },
      { href: "/#faq", label: "FAQ" },
      { href: "/garage-management-software", label: "Garage management software" },
    ],
  },
  {
    heading: "Trades",
    links: [
      { href: "/mobile-tyre-fitting-software", label: "Mobile tyre fitting" },
      { href: "/auto-locksmith-software", label: "Auto locksmiths" },
      { href: "/ecu-remapping-software", label: "ECU remapping" },
      { href: "/mot-test-centre-software", label: "MOT test centres" },
      { href: "/fleet-maintenance-software", label: "Fleet maintenance" },
    ],
  },
  {
    heading: "Compare",
    links: [
      { href: "/vs/garage-hive", label: "vs Garage Hive" },
      { href: "/vs/techman", label: "vs TechMan" },
      { href: "/vs/dragon2000", label: "vs Dragon2000" },
      { href: "/vs/motasoft", label: "vs Motasoft" },
      { href: "/garage-hive-alternatives", label: "Garage Hive alternatives" },
    ],
  },
  {
    heading: "Company",
    links: [
      { href: "/contact", label: "Contact" },
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
      { href: "/#waiting-list", label: "Waiting list" },
    ],
  },
];
---

<footer class="border-t border-border-grey">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      {
        columns.map((column) => (
          <div>
            <h2 class="font-heading text-xs font-bold uppercase tracking-widest text-muted-text">{column.heading}</h2>
            <ul class="mt-4 flex flex-col gap-3">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm font-semibold text-body-text transition-colors hover:text-coral-orange">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col items-center gap-4 border-t border-border-grey pt-8 sm:flex-row sm:justify-between">
      <Logo iconSize={26} />
      <p class="text-sm text-muted-text">
        © {year} {SITE.name}. <a href={`mailto:${SITE.contactEmail}`} class="hover:text-workshop-black">{SITE.contactEmail}</a>
      </p>
    </div>
  </div>
</footer>
