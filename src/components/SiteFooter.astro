---
import Logo from "./Logo.astro";
import { SITE } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-border-grey">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 sm:flex-row">
    <Logo iconSize={26} />
    <p class="text-sm text-muted-text">
      © {year} {SITE.name}. <a href={`mailto:${SITE.contactEmail}`} class="hover:text-workshop-black">{SITE.contactEmail}</a>
    </p>
  </div>
</footer>
