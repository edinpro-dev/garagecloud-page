---
interface Props {
  showWordmark?: boolean;
  iconSize?: number;
  class?: string;
}

const { showWordmark = true, iconSize = 36, class: className = "" } = Astro.props;

const ICON_ASPECT_RATIO = 232 / 171;
const iconWidth = Math.round(iconSize * ICON_ASPECT_RATIO);
---

<div class:list={["inline-flex items-center gap-2.5", className]}>
  <img
    src="/logo-icon.png"
    alt="GarageCloud logo"
    width={iconWidth}
    height={iconSize}
    style={`height: ${iconSize}px; width: ${iconWidth}px;`}
  />

  {
    showWordmark && (
      <span class="font-heading text-lg font-extrabold tracking-tight text-workshop-black sm:text-2xl">
        Garage<span class="text-gradient-primary">Cloud</span>
      </span>
    )
  }
</div>
