---
import { FEATURES } from "../data/site";

const tints = [
  "bg-coral-orange/10",
  "bg-deep-magenta/10",
  "bg-deep-purple/10",
  "bg-amber-orange/15",
];
---

<section id="features" class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
  <div class="reveal mx-auto max-w-2xl text-center">
    <span class="text-coral-orange font-heading text-xs font-bold uppercase tracking-widest">What's included</span>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">What's included in GarageCloud</h2>
    <p class="mt-4 text-lg text-body-text">
      Built for garages and every trade around them, from tyres to locksmiths.
    </p>
  </div>

  <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      FEATURES.map((feature, index) => (
        <div
          class="reveal group rounded-2xl border border-border-grey bg-canvas-white p-6 transition-all duration-200 hover:-translate-y-1 hover:border-coral-orange/30 hover:shadow-lg hover:shadow-workshop-black/5"
          style={`transition-delay: ${(index % 3) * 80}ms`}
        >
          <div
            class={`flex h-12 w-12 items-center justify-center rounded-full text-2xl transition-transform duration-200 group-hover:scale-110 ${tints[index % tints.length]}`}
            aria-hidden="true"
          >
            {feature.icon}
          </div>
          <h3 class="mt-4 text-base font-bold text-workshop-black">{feature.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-text">{feature.description}</p>
        </div>
      ))
    }
  </div>
</section>
