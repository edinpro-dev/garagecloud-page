---
import { INTEGRATIONS } from "../data/site";
---

<section class="bg-canvas-white" aria-label="Integrations">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-center gap-4 px-6 pb-14 sm:flex-row sm:gap-8">
    <span class="text-sm font-semibold text-muted-text">Works with the tools you already use</span>
    <div class="flex flex-wrap items-center justify-center gap-3">
      {
        INTEGRATIONS.map((integration) => (
          <span class="rounded-full border border-border-grey bg-canvas-white px-4 py-1.5 font-heading text-sm font-bold text-workshop-black">
            {integration.name}
          </span>
        ))
      }
    </div>
  </div>
</section>
