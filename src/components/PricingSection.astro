---
import { Check } from "@lucide/astro";
import { PRICING_TIERS, SITE } from "../data/site";
---

<section id="pricing" class="border-b border-border-grey">
  <div class="mx-auto max-w-page px-6 py-20 lg:px-20">
    <div class="mx-auto max-w-[60ch] text-center">
      <p class="brand-label text-body-text">Pricing</p>
      <h2 class="mt-3 font-heading text-h1 font-bold text-balance">GarageCloud pricing</h2>
      <p class="mt-4 text-body-text">
        Simple plans, no hidden add-ons. One monthly price per workshop, however many staff you put on it. Planned
        launch pricing, confirmed when we launch.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        PRICING_TIERS.map((tier) => (
          <div
            class:list={[
              "relative flex flex-col rounded-lg border bg-canvas-white p-8",
              tier.highlighted ? "border-2 border-navy lg:-mt-4 lg:mb-4" : "border-border-strong",
            ]}
          >
            {tier.badge && (
              <span class="badge absolute -top-3 left-1/2 -translate-x-1/2">{tier.badge}</span>
            )}

            <h3 class="font-heading text-h2 font-semibold">{tier.name}</h3>
            <p class="mt-2 text-sm text-body-text">{tier.tagline}</p>

            <div class="mt-6 flex items-end gap-1">
              <span class="tabular font-num text-display font-bold text-workshop-black">
                {tier.price}
              </span>
              <span class="mb-2 text-sm text-muted-text">/mo</span>
            </div>
            <p class="mt-1 text-sm text-muted-text">A month, excluding VAT</p>

            <a
              href="/#waiting-list"
              class:list={["btn mt-6 w-full", tier.highlighted ? "btn-primary" : "btn-secondary"]}
            >
              Join the waiting list
            </a>

            <ul class="mt-8 space-y-3 border-t border-border-grey pt-6 text-sm">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <Check class="mt-0.5 size-4 shrink-0 text-workshop-black" stroke-width={2.5} />
                  <span class="text-body-text">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-center text-sm text-body-text">
      Prices are in GBP and exclude VAT. If anything changes before launch, the waiting list hears first.{" "}
      <a href={`mailto:${SITE.contactEmail}`} class="brand-link font-medium">Email us with a question</a>.
    </p>
  </div>
</section>
