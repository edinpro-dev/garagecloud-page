---
import Logo from "./Logo.astro";

const navLinks = [
  { href: "/#features", label: "Features" },
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#pricing", label: "Pricing" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-40 border-b border-border-grey bg-canvas-white/85 backdrop-blur-xl">
  <div class="relative mx-auto flex h-16 max-w-page items-center justify-between gap-6 px-6 lg:px-20">
    <a href="/" aria-label="GarageCloud home" class="shrink-0">
      <Logo iconSize={28} />
    </a>

    <nav class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-1 md:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="group relative rounded-md px-3 py-2 text-sm text-body-text transition-colors hover:text-workshop-black focus-visible:ring-2 focus-visible:ring-navy focus-visible:outline-none"
          >
            {link.label}
            <span class="absolute inset-x-3 bottom-1 h-0.5 origin-center scale-x-0 bg-navy transition-transform duration-200 group-hover:scale-x-100" />
          </a>
        ))
      }
    </nav>

    <!-- Secondary, not primary: the header is sticky, so a navy button here would
         sit beside whichever section CTA is in view. -->
    <a href="/#waiting-list" class="btn btn-sm btn-secondary">Join waiting list</a>
  </div>
</header>
