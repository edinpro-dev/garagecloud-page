---
import Logo from "./Logo.astro";
---

<header class="sticky top-0 z-50 border-b border-border-grey bg-canvas-white/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-4 sm:px-6">
    <Logo iconSize={30} class="shrink-0" />
    <a
      href="#waiting-list"
      class="bg-gradient-primary shrink-0 whitespace-nowrap rounded-full px-4 py-2.5 font-heading text-sm font-bold text-white shadow-sm transition-transform hover:scale-[1.03] sm:px-5"
    >
      <span class="sm:hidden">Join list</span>
      <span class="hidden sm:inline">Join waiting list</span>
    </a>
  </div>
</header>
