---
import Logo from "./Logo.astro";

const navLinks = [
  { href: "/#features", label: "Features" },
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#pricing", label: "Pricing" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-50 border-b border-border-grey bg-canvas-white/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-4 sm:px-6">
    <a href="/" class="shrink-0">
      <Logo iconSize={30} />
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a href={link.href} class="text-sm font-semibold text-body-text transition-colors hover:text-coral-orange">
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/#waiting-list"
      class="bg-gradient-primary shrink-0 whitespace-nowrap rounded-full px-4 py-2.5 font-heading text-sm font-bold text-white shadow-sm transition-transform hover:scale-[1.03] sm:px-5"
    >
      <span class="md:hidden">Join list</span>
      <span class="hidden md:inline">Join waiting list</span>
    </a>
  </div>
</header>
