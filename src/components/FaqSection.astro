---
import { Plus } from "@lucide/astro";
import { FAQS, SITE } from "../data/site";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${Astro.site}#faq`,
  mainEntity: FAQS.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<section id="faq" class="border-b border-border-grey bg-section-grey">
  <div class="mx-auto max-w-page px-6 py-20 lg:px-20">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <p class="brand-label text-body-text">FAQ</p>
        <h2 class="mt-3 font-heading text-h1 font-bold text-balance">Garage management software FAQs</h2>
        <p class="mt-4 max-w-[50ch] text-body-text">
          Still stuck on something? <a href={`mailto:${SITE.contactEmail}`} class="brand-link">{SITE.contactEmail}</a>{" "}
          reaches a person, not a ticket queue.
        </p>
      </div>

      <div class="divide-y divide-border-grey border-y border-border-grey">
        {
          FAQS.map((faq) => (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-6 text-left [&::-webkit-details-marker]:hidden">
                <h3 class="font-heading text-base font-semibold">{faq.question}</h3>
                <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full border border-border-grey bg-canvas-white text-workshop-black transition-transform duration-200 group-open:rotate-45">
                  <Plus class="size-3.5" stroke-width={2.5} />
                </span>
              </summary>
              <p class="max-w-[70ch] pr-10 pb-6 text-sm text-body-text">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
